<style>
  .footer {
    margin-top: 0px;
  }
  .section-footer-padding {
    padding-top: 24px;
    padding-bottom: 15px;
  }
  @media screen and (min-width: 750px) {
    .footer {
      margin-top: 0px;
    }
    .section-footer-padding {
      padding-top: 32px;
      padding-bottom: 20px;
    }
  }
  .footer__content-top {
    display: grid;
    gap: 2rem;
  }
  @media screen and (min-width: 750px) {
    .footer__content-top {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .footer-block__heading {
    font-size: 1.4rem;
    font-weight: 700;
    margin-bottom: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .footer-block__details-content {
    font-size: 1.4rem;
    line-height: 1.7;
  }
  .footer__content-bottom {
    margin-top: 2rem;
    border-top: 1px solid rgba(255,255,255,0.2);
    padding-top: 1.5rem;
  }
  .footer__copyright {
    font-size: 1.2rem;
    opacity: 0.8;
  }
  .footer__payment {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1rem;
    list-style: none;
    padding: 0;
  }
  .newsletter-form {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    margin-top: 1rem;
  }
  .newsletter-form .field {
    position: relative;
  }
  .newsletter-form .field__input {
    width: 100%;
    padding: 1rem;
    border: 1px solid rgba(255,255,255,0.3);
    border-radius: var(--inputs-radius);
    background: rgba(255,255,255,0.1);
    color: inherit;
    font-family: inherit;
    font-size: 1.4rem;
  }
  .newsletter__solid-btn {
    background: rgba(255,255,255,0.2);
    color: inherit;
    border: 1px solid rgba(255,255,255,0.4);
    padding: 1rem 2rem;
    border-radius: var(--buttons-radius);
    cursor: pointer;
    font-weight: 700;
    letter-spacing: 0.05em;
    font-size: 1.4rem;
    transition: background 0.2s;
  }
  .newsletter__solid-btn:hover { background: rgba(255,255,255,0.3); }
  .list-unstyled { list-style: none; padding: 0; margin: 0; }
  .link { color: inherit; text-decoration: none; }
  .link:hover { text-decoration: underline; }
</style>

<footer class="footer color-accent-1 gradient section-footer-padding">
  <div class="footer__content-top page-width">
    <div class="footer-block">
      <h2 class="footer-block__heading">{{ shop.name }}</h2>
      <div class="footer-block__details-content">
        {%- if section.settings.footer_description != blank -%}
          <p>{{ section.settings.footer_description }}</p>
        {%- endif -%}
      </div>
    </div>

    <div class="footer-block">
      <h2 class="footer-block__heading">Quick links</h2>
      <ul class="footer-block__details-content list-unstyled">
        {%- for link in section.settings.footer_menu.links -%}
          <li>
            <a href="{{ link.url }}" class="link link--text list-menu__item list-menu__item--link">
              {{ link.title }}
            </a>
          </li>
        {%- endfor -%}
        <li>
          <a href="/search" class="link link--text list-menu__item list-menu__item--link">Search</a>
        </li>
      </ul>
    </div>

    <div class="footer-block">
      <h2 class="footer-block__heading">Subscribe to our emails</h2>
      <div class="footer-block__details-content">
        <p>Subscribe to our newsletter for special offers and discounts.</p>
      </div>
      {%- form 'customer', id: 'ContactFooter' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="newsletter-form">
          <div class="field">
            <input
              id="NewsletterForm--{{ section.id }}"
              type="email"
              name="contact[email]"
              class="field__input"
              value="{{ form.email }}"
              aria-required="true"
              autocorrect="off"
              autocapitalize="off"
              autocomplete="email"
              placeholder="Email"
              required
            >
          </div>
          <button type="submit" class="button newsletter__solid-btn button--full-width" name="commit" id="Subscribe" aria-label="Subscribe">
            Sign up
          </button>
        </div>
      {%- endform -%}
    </div>
  </div>

  <div class="footer__content-bottom">
    <div class="footer__content-bottom-wrapper page-width">
      <ul class="footer__payment list-payment" role="list">
        {%- for type in shop.enabled_payment_types -%}
          <li class="list-payment__item">
            {{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}
          </li>
        {%- endfor -%}
      </ul>
      <div class="footer__copyright caption">
        <small class="copyright__content">
          &copy; {{ 'now' | date: '%Y' }}, <a href="{{ shop.url }}" title="{{ shop.name }}">{{ shop.name }}</a>
        </small>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "shopify-section-group-footer-group",
  "settings": [
    {
      "type": "textarea",
      "id": "footer_description",
      "label": "Footer description",
      "default": "Handcrafted resin art made with love."
    },
    {
      "type": "link_list",
      "id": "footer_menu",
      "default": "footer",
      "label": "Footer menu"
    }
  ]
}
{% endschema %}
