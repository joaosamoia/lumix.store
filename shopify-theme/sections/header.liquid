<style>
  .section-header {
    position: sticky;
    top: 0;
    z-index: 3;
    margin-bottom: 0;
  }
  .header-wrapper {
    background-color: rgb(var(--color-base-background-1));
    border-bottom: 1px solid rgba(var(--color-base-text), 0.08);
  }
  .header {
    display: grid;
    grid-template-areas: "left-icons heading right-icons";
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding: 10px 3rem;
    max-width: var(--page-width);
    margin: 0 auto;
  }
  @media screen and (min-width: 990px) {
    .header {
      grid-template-areas: "navigation heading icons";
      padding: 20px 3rem;
    }
  }
  .header__heading-link {
    grid-area: heading;
    text-decoration: none;
    color: rgb(var(--color-base-text));
    font-size: 2rem;
    font-weight: var(--font-body-weight-bold);
    white-space: nowrap;
  }
  .header__logo-image {
    max-width: 200px;
    height: auto;
  }
  @media screen and (max-width: 749px) {
    .header__logo-image { max-width: 120px; }
  }
  .header__icons {
    grid-area: right-icons;
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 1rem;
  }
  .header__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgb(var(--color-base-text));
    text-decoration: none;
    padding: 0.4rem;
    background: none;
    border: none;
    cursor: pointer;
  }
  .header__icon svg {
    width: 2.4rem;
    height: 2.4rem;
  }
  .header__inline-menu {
    grid-area: navigation;
    display: none;
  }
  @media screen and (min-width: 990px) {
    .header__inline-menu { display: flex; }
  }
  .list-menu {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0 2rem;
  }
  .header__menu-item {
    display: flex;
    align-items: center;
    font-size: 1.4rem;
    text-decoration: none;
    color: rgb(var(--color-base-text));
    padding: 0.5rem 0;
  }
  .header__menu-item:hover {
    color: rgb(var(--color-base-accent-1));
  }
  /* Mobile hamburger */
  .header-drawer {
    grid-area: left-icons;
    display: flex;
  }
  @media screen and (min-width: 990px) {
    .header-drawer { display: none; }
  }
  /* Menu drawer */
  .menu-drawer {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    max-width: 36rem;
    height: 100%;
    background: rgb(var(--color-base-background-1));
    transform: translateX(-100%);
    transition: transform 0.3s ease;
    z-index: 100;
    overflow-y: auto;
    padding: 2rem;
    box-shadow: 2px 0 8px rgba(0,0,0,0.15);
  }
  .menu-drawer.is-open {
    transform: translateX(0);
  }
  .menu-drawer-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.4);
    z-index: 99;
  }
  .menu-drawer-overlay.is-visible {
    display: block;
  }
  .menu-drawer__title-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
  }
  .menu-drawer__nav ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .menu-drawer__nav li a {
    display: block;
    padding: 1.2rem 0;
    border-bottom: 1px solid rgba(var(--color-base-text), 0.08);
    font-size: 1.6rem;
    text-decoration: none;
    color: rgb(var(--color-base-text));
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0,0,0,0);
    white-space: nowrap;
    border: 0;
  }
</style>

<div class="section-header">
  <div class="header-wrapper">
    <header class="header">

      <!-- Mobile hamburger -->
      <div class="header-drawer">
        <button class="header__icon" id="menu-toggle" aria-label="Open menu" aria-expanded="false">
          <svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false" fill="none" viewBox="0 0 18 16">
            <path d="M1 .5a.5.5 0 100 1h15.71a.5.5 0 000-1H1zM.5 8a.5.5 0 01.5-.5h15.71a.5.5 0 010 1H1A.5.5 0 01.5 8zm0 7a.5.5 0 01.5-.5h15.71a.5.5 0 010 1H1a.5.5 0 01-.5-.5z" fill="currentColor"/>
          </svg>
        </button>
      </div>

      <!-- Desktop nav -->
      <nav class="header__inline-menu">
        <ul class="list-menu">
          {%- for link in section.settings.menu.links -%}
            <li>
              <a href="{{ link.url }}" class="header__menu-item">{{ link.title }}</a>
            </li>
          {%- endfor -%}
        </ul>
      </nav>

      <!-- Logo / Store name -->
      <a href="{{ routes.root_url }}" class="header__heading-link">
        {%- if section.settings.logo != blank -%}
          <img src="{{ section.settings.logo | img_url: '400x' }}" alt="{{ shop.name }}" class="header__logo-image">
        {%- else -%}
          <span class="h2">{{ shop.name }}</span>
        {%- endif -%}
      </a>

      <!-- Icons -->
      <div class="header__icons">
        <a href="{{ routes.account_url }}" class="header__icon small-hide" aria-label="Log in">
          <svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false" fill="none" viewBox="0 0 18 19">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M6 4.5a3 3 0 116 0 3 3 0 01-6 0zm3-4a4 4 0 100 8 4 4 0 000-8zm5.58 12.15c1.12.82 1.83 2.24 1.91 4.85H1.51c.08-2.6.79-4.03 1.9-4.85C4.66 11.75 6.5 11.5 9 11.5s4.35.26 5.58 1.15zM9 10.5c-2.5 0-4.65.24-6.17 1.35C1.27 12.98.5 14.93.5 18v.5h17V18c0-3.07-.77-5.02-2.33-6.15-1.52-1.1-3.67-1.35-6.17-1.35z" fill="currentColor"/>
          </svg>
          <span class="visually-hidden">Log in</span>
        </a>
        <a href="{{ routes.cart_url }}" class="header__icon" id="cart-icon-bubble" aria-label="Cart ({{ cart.item_count }})">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 53.98 45.23" aria-hidden="true" focusable="false" fill="none">
            <polyline stroke="currentColor" points="1.5 1.5 10.04 2.06 15.09 27.94 45.39 27.94 52.48 6.79 18.25 6.65" style="fill:none;stroke-linecap:round;stroke-linejoin:round;stroke-width:3px"/>
            <circle stroke="currentColor" cx="20.58" cy="39.74" r="3.99" style="fill:none;stroke-linecap:round;stroke-linejoin:round;stroke-width:3px"/>
            <circle stroke="currentColor" cx="40.02" cy="39.74" r="3.99" style="fill:none;stroke-linecap:round;stroke-linejoin:round;stroke-width:3px"/>
            <polyline stroke="currentColor" points="45.42 35.75 14.49 35.75 17.21 27.94" style="fill:none;stroke-linecap:round;stroke-linejoin:round;stroke-width:3px"/>
          </svg>
          {%- if cart.item_count > 0 -%}
            <span class="cart-count-bubble">{{ cart.item_count }}</span>
          {%- endif -%}
          <span class="visually-hidden">Cart</span>
        </a>
      </div>
    </header>
  </div>
</div>

<!-- Mobile menu drawer -->
<div class="menu-drawer-overlay" id="menu-overlay"></div>
<div class="menu-drawer" id="mobile-menu" role="dialog" aria-modal="true" aria-label="Menu">
  <div class="menu-drawer__title-row">
    <h3>Menu</h3>
    <button class="header__icon" id="menu-close" aria-label="Close menu">
      <svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false" fill="none" viewBox="0 0 18 17">
        <path d="M.865 15.978a.5.5 0 00.707.707l7.433-7.431 7.579 7.282a.501.501 0 00.846-.37.5.5 0 00-.153-.351L9.712 8.546l7.417-7.416a.5.5 0 10-.707-.708L8.991 7.853 1.413.573a.5.5 0 10-.693.72l7.563 7.268-7.418 7.417z" fill="currentColor"/>
      </svg>
    </button>
  </div>
  <nav class="menu-drawer__nav">
    <ul>
      {%- for link in section.settings.menu.links -%}
        <li><a href="{{ link.url }}">{{ link.title }}</a></li>
      {%- endfor -%}
    </ul>
  </nav>
</div>

<script>
  (function() {
    var toggle = document.getElementById('menu-toggle');
    var menu = document.getElementById('mobile-menu');
    var overlay = document.getElementById('menu-overlay');
    var closeBtn = document.getElementById('menu-close');
    function openMenu() {
      menu.classList.add('is-open');
      overlay.classList.add('is-visible');
      toggle.setAttribute('aria-expanded', 'true');
    }
    function closeMenu() {
      menu.classList.remove('is-open');
      overlay.classList.remove('is-visible');
      toggle.setAttribute('aria-expanded', 'false');
    }
    if (toggle) toggle.addEventListener('click', openMenu);
    if (closeBtn) closeBtn.addEventListener('click', closeMenu);
    if (overlay) overlay.addEventListener('click', closeMenu);
  })();
</script>

{% schema %}
{
  "name": "Header",
  "class": "shopify-section-group-header-group section-header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    }
  ],
  "presets": [
    {
      "name": "Header"
    }
  ]
}
{% endschema %}
