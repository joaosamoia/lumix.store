<style>
  .horizontal-ticker {
    overflow: hidden;
    white-space: nowrap;
    width: 100%;
  }
  .horizontal-ticker__container {
    display: inline-flex;
    animation: horizontalTicker {{ section.settings.speed }}s linear infinite forwards;
    column-gap: 60px;
  }
  @media screen and (min-width: 750px) {
    .horizontal-ticker__container {
      column-gap: 100px;
      animation-name: horizontalTickerDesktop;
    }
  }
  .horizontal-ticker__item {
    font-size: 1.75rem;
    font-weight: 700;
    padding: 0;
    margin: 0;
    white-space: nowrap;
  }
  @keyframes horizontalTicker {
    to { transform: translateX(calc(-50% - 30px)); }
  }
  @keyframes horizontalTickerDesktop {
    to { transform: translateX(calc(-50% - 50px)); }
  }
  .section-announcement-bar-padding {
    padding-top: 12px;
    padding-bottom: 12px;
  }
  @media screen and (min-width: 750px) {
    .section-announcement-bar-padding {
      padding-top: 16px;
      padding-bottom: 16px;
    }
  }
</style>

<div class="horizontal-ticker color-accent-1 section-announcement-bar-padding">
  <div class="horizontal-ticker__container">
    {%- for i in (1..10) -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'text' -%}
          <p class="horizontal-ticker__item">{{ block.settings.text }}</p>
        {%- endif -%}
      {%- endfor -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Announcement bar",
  "class": "shopify-section-group-header-group",
  "settings": [
    {
      "type": "range",
      "id": "speed",
      "min": 20,
      "max": 100,
      "step": 5,
      "default": 50,
      "label": "Ticker speed (seconds)"
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Text item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "default": "Announcement",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement bar",
      "blocks": [
        { "type": "text", "settings": { "text": "WELCOME!" } },
        { "type": "text", "settings": { "text": "FREE WORLDWIDE SHIPPING!" } },
        { "type": "text", "settings": { "text": "INDIVIDUALLY HANDCRAFTED" } }
      ]
    }
  ]
}
{% endschema %}
